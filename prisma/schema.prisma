// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  bio           String?
  image         String?
  resumeUrl     String?
  twitterUrl    String?
  role          String             @default("worker") // "admin", "owner", "worker"
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  listings      AccountListing[]
  applications  WorkerApplication[]
  matches       Match[]
  notifications Notification[]
  blogPosts     BlogPost[]
}

model WorkerApplication {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  firstName     String
  lastName      String
  email         String
  phone         String
  country       String
  expertise     String
  experience    String
  internet      String
  power         String
  idType        String
  idDocumentUrl String?
  nin           String?
  dailyHours    String?
  pcType        String? // "Windows", "Mac", "None"
  performedTasks String?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  appliedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AccountListing {
  id              String   @id @default(uuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id])
  platform        String
  taskTypes       String[]
  avgEarning      Float
  accountAge      String
  ownerSplit      Int      @default(35)
  availability    String   @default("immediate")
  requireTrial    Boolean  @default(true)
  trialDays       Int      @default(14)
  description     String?
  proofUrl        String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  matches         Match[]
}

model Match {
  id            String         @id @default(uuid())
  listingId     String
  listing       AccountListing @relation(fields: [listingId], references: [id])
  workerId      String
  worker        User           @relation(fields: [workerId], references: [id])
  status        String         @default("PENDING") // PENDING, ONGOING, TERMINATED
  startedAt     DateTime?
  earningsTotal Float          @default(0)
  createdAt     DateTime       @default(now())
}

model EmailVerification {
  id         Int      @id @default(autoincrement())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  imageUrl  String?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Stores every filled + signed document (agent agreements, tasker contracts).
// Kept separate from the rest of the app data.
model SignedDocument {
  id             String   @id @default(uuid())
  docType        String   // "AGENT_AGREEMENT" | "TASKER_CONTRACT_OUTLIER"
  fullName       String
  firstName      String?
  lastName       String?
  email          String
  phone          String?
  country        String?  // agent agreements
  region         String?  // tasker contracts: "UK" | "US" | "Both"
  dob            String?
  address        String?
  payoutMethod   String?  // tasker contracts
  commissionRate String?  // agent agreements: "5" | "7" | "10"
  teamLead       String?  // tasker contracts
  signatureImage String   // base64 PNG data URL of the drawn signature
  signedAt       DateTime @default(now()) // auto date of signing
  createdAt      DateTime @default(now())

  @@index([docType])
  @@index([email])
}

// Service bookings taken by the Open Claw Telegram bot.
// Open Claw creates an order, the team is emailed, payment is confirmed, then
// the customer is released to WhatsApp.
model Order {
  id        String    @id @default(uuid())
  reference String    @unique // e.g. "WP-7F3K9Q"
  name      String
  service   String
  amount    String
  whatsapp  String
  email     String?
  notes     String?
  status    String    @default("PENDING") // PENDING, PAID, CANCELLED
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([reference])
  @@index([status])
}
